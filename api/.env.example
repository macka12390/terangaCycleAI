# Copier en `.env` (jamais versionné). Toutes les valeurs ont un défaut raisonnable.

# Écoute du serveur : 0.0.0.0 pour tester depuis un téléphone sur le même Wi-Fi.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=1

# Clé de signature des jetons de démo. Vide : une clé est générée une fois dans
# instance/secret_key (hors Git).
# SECRET_KEY=

# Base SQLite par défaut : instance/terangacycle.db
# DATABASE_URL=sqlite:///C:/chemin/vers/terangacycle.db

# Dossier des photos (défaut : api/uploads).
# UPLOAD_FOLDER=

# Origines autorisées (CORS), séparées par des virgules.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Classification : auto (CLIP si installé et téléchargé, sinon manuel), clip ou manual.
AI_BACKEND=auto
# AI_MODEL_DIR=instance/models/clip-vit-base-patch32
AI_CONFIDENCE_THRESHOLD=0.6
